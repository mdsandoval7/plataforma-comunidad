DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ccicaepcc?schema=public"
# Set to https://icaepcamelot.vercel.app in Vercel.
BASE_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# SMTP settings used for first-time account welcome emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Comma-separated addresses allowed to manage all ministries and review content.
PASTOR_EMAILS=""
ADMIN_EMAILS=""

# Semicolon-separated church codes and display names.
CHURCHES="ciudad-camelot:CCICAEPCC Ciudad Camelot"

# Additional leaders (presidente.dynamos@gmail.com is built in as a Dynamos leader).
# Add up to 33 more comma-separated entries for an initial list of 34 leaders.
# Format: leader@example.org=damas@ciudad-camelot,another@example.org=banda@iglesia-hija
LEADER_ACCESS=""
